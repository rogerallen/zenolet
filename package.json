    "@types/qrcode": "^1.5.5",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.1.0",
    "vitest": "^1.3.0"
  }
